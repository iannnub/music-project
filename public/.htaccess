<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType image/webp .webp
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/manifest+json "access plus 1 month"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Jika file atau folder fisik ada, gunakan langsung
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Jika tidak ada, arahkan semua ke index.php
    RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
</IfModule>